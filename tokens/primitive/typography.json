{
  "primitive": {
    "font-family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "serif": { "$value": ["Georgia", "Cambria", "Times New Roman", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"] }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "font-size": {
      "$type": "dimension",
      "$description": "Modular scale in px. Built to rem at output time.",
      "75": { "$value": "12px" },
      "100": { "$value": "14px" },
      "200": { "$value": "16px" },
      "300": { "$value": "18px" },
      "400": { "$value": "20px" },
      "500": { "$value": "24px" },
      "600": { "$value": "30px" },
      "700": { "$value": "36px" },
      "800": { "$value": "48px" }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "snug": { "$value": 1.35 },
      "normal": { "$value": 1.5 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em" },
      "wider": { "$value": "0.08em" }
    }
  }
}
