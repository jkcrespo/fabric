{
  "primitive": {
    "space": {
      "$type": "dimension",
      "$description": "4px grid with finer steps for precision. The key is px × 25: space.400 = 16px. Matches MUI theme.spacing(4).",
      "000": { "$value": "0px" },
      "025": { "$value": "1px" },
      "050": { "$value": "2px" },
      "075": { "$value": "3px" },
      "100": { "$value": "4px" },
      "150": { "$value": "6px" },
      "200": { "$value": "8px" },
      "250": { "$value": "10px" },
      "300": { "$value": "12px" },
      "400": { "$value": "16px" },
      "500": { "$value": "20px" },
      "600": { "$value": "24px" },
      "800": { "$value": "32px" },
      "1000": { "$value": "40px" },
      "1200": { "$value": "48px" },
      "1400": { "$value": "56px" },
      "1600": { "$value": "64px" },
      "2000": { "$value": "80px" },
      "2400": { "$value": "96px" },
      "2800": { "$value": "112px" },
      "3200": { "$value": "128px" },
      "negative": {
        "$description": "Negative values for intentional overlaps (stacked avatars, pulled-up media).",
        "100": { "$value": "-4px" },
        "200": { "$value": "-8px" },
        "300": { "$value": "-12px" },
        "400": { "$value": "-16px" },
        "500": { "$value": "-20px" },
        "600": { "$value": "-24px" }
      }
    },
    "radius": {
      "$type": "dimension",
      "000": { "$value": "0px" },
      "050": { "$value": "2px" },
      "150": { "$value": "6px" },
      "200": { "$value": "8px" },
      "300": { "$value": "12px" },
      "full": { "$value": "10000px" }
    },
    "breakpoint": {
      "$type": "dimension",
      "$description": "Matches MUI default breakpoints.",
      "xs": { "$value": "0px" },
      "sm": { "$value": "600px" },
      "md": { "$value": "900px" },
      "lg": { "$value": "1200px" },
      "xl": { "$value": "1536px" }
    }
  }
}
