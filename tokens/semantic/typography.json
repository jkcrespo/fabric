    "overline": {"$value": {"fontFamily": "{brand.font-family.body}", "fontWeight": "{primitive.font-weight.semibold}", "fontSize": "{primitive.font-size.75}", "lineHeight": "{primitive.line-height.normal}", "letterSpacing": "{primitive.letter-spacing.wider}"}, "$description": "Eyebrow label above a heading. Emphasis comes from weight and letter-spacing, not text case.", "$extensions": {"com.fabric": {"mui": "typography.overline"}}}
