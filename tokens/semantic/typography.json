    "display-md": {"$value": {"fontFamily": "{brand.font-family.heading}", "fontWeight": "{primitive.font-weight.bold}", "fontSize": "{primitive.font-size.700}", "lineHeight": "{primitive.line-height.tight}", "letterSpacing": "{primitive.letter-spacing.tight}"}, "$description": "Primary page title.", "$extensions": {"com.fabric": {"mui": "typography.h2"}}},
    "heading-lg": {"$value": {"fontFamily": "{brand.font-family.heading}", "fontWeight": "{primitive.font-weight.semibold}", "fontSize": "{primitive.font-size.600}", "lineHeight": "{primitive.line-height.tight}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Section heading.", "$extensions": {"com.fabric": {"mui": "typography.h3"}}},
    "heading-md": {"$value": {"fontFamily": "{brand.font-family.heading}", "fontWeight": "{primitive.font-weight.semibold}", "fontSize": "{primitive.font-size.500}", "lineHeight": "{primitive.line-height.snug}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Subsection heading.", "$extensions": {"com.fabric": {"mui": "typography.h4"}}},
