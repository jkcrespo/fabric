    "heading-xs": {"$value": {"fontFamily": "{brand.font-family.heading}", "fontWeight": "{primitive.font-weight.semibold}", "fontSize": "{primitive.font-size.300}", "lineHeight": "{primitive.line-height.snug}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Small group headings, list headers.", "$extensions": {"com.fabric": {"mui": "typography.h6"}}},
    "title-md": {"$value": {"fontFamily": "{brand.font-family.body}", "fontWeight": "{primitive.font-weight.medium}", "fontSize": "{primitive.font-size.200}", "lineHeight": "{primitive.line-height.normal}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Emphasised lead-in text above body copy.", "$extensions": {"com.fabric": {"mui": "typography.subtitle1"}}},
    "title-sm": {"$value": {"fontFamily": "{brand.font-family.body}", "fontWeight": "{primitive.font-weight.medium}", "fontSize": "{primitive.font-size.100}", "lineHeight": "{primitive.line-height.normal}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Compact emphasised labels in dense UI.", "$extensions": {"com.fabric": {"mui": "typography.subtitle2"}}},
    "body-md": {"$value": {"fontFamily": "{brand.font-family.body}", "fontWeight": "{primitive.font-weight.regular}", "fontSize": "{primitive.font-size.200}", "lineHeight": "{primitive.line-height.normal}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Default reading text.", "$extensions": {"com.fabric": {"mui": "typography.body1"}}},
    "body-sm": {"$value": {"fontFamily": "{brand.font-family.body}", "fontWeight": "{primitive.font-weight.regular}", "fontSize": "{primitive.font-size.100}", "lineHeight": "{primitive.line-height.normal}", "letterSpacing": "{primitive.letter-spacing.normal}"}, "$description": "Dense UI text: tables, secondary content.", "$extensions": {"com.fabric": {"mui": "typography.body2"}}},
