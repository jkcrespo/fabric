{
  "$description": "Acme — example second brand proving the white-label contract: warm orange + violet, serif headings, sharper corners.",
  "brand": {
    "color": {
      "$type": "color",
      "primary": {
        "$description": "Orange",
        "50": { "$value": "#fff7ed" },
        "100": { "$value": "#ffedd5" },
        "200": { "$value": "#fed7aa" },
        "300": { "$value": "#fdba74" },
        "400": { "$value": "#fb923c" },
        "500": { "$value": "#f97316" },
        "600": { "$value": "#c2410c" },
        "700": { "$value": "#9a3412" },
        "800": { "$value": "#7c2d12" },
        "900": { "$value": "#431407" }
      },
      "secondary": {
        "$description": "Violet",
        "50": { "$value": "#f5f3ff" },
        "100": { "$value": "#ede9fe" },
        "200": { "$value": "#ddd6fe" },
        "300": { "$value": "#c4b5fd" },
        "400": { "$value": "#a78bfa" },
        "500": { "$value": "#8b5cf6" },
        "600": { "$value": "#7c3aed" },
        "700": { "$value": "#6d28d9" },
        "800": { "$value": "#5b21b6" },
        "900": { "$value": "#2e1065" }
      }
    },
    "font-family": {
      "$type": "fontFamily",
      "heading": { "$value": "{primitive.font-family.serif}" },
      "body": { "$value": "{primitive.font-family.sans}" }
    },
    "radius": {
      "$type": "dimension",
      "control": { "$value": "{primitive.radius.sm}" },
      "container": { "$value": "{primitive.radius.sm}" }
    }
  }
}
