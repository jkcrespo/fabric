{
  "name": "@jkcrespo/fabric-react",
  "version": "0.1.0",
  "description": "Fabric React components on MUI, each with machine-readable metadata for AI agents.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components.json": "./dist/components.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-meta.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@jkcrespo/fabric-theme": "0.1.0",
    "@jkcrespo/fabric-tokens": "0.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jkcrespo/fabric.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
