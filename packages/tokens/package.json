{
  "name": "@jkcrespo/fabric-tokens",
  "version": "0.1.0",
  "description": "Fabric design tokens: CSS variables, typed JS and an agent-readable manifest for every brand and mode.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./manifest.json": "./dist/manifest.json",
    "./*.css": "./dist/*.css",
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node build.mjs"
  },
  "repository": { "type": "git", "url": "https://github.com/jkcrespo/fabric.git", "directory": "packages/tokens" },
  "publishConfig": { "access": "public" }
}
