{
  "name": "@jkcrespo/fabric-mcp",
  "version": "0.1.0",
  "description": "MCP server for Fabric: AI agents look up rules, tokens and component contracts on demand.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fabric-mcp": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build-data.mjs && tsc -p tsconfig.json && chmod +x dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jkcrespo/fabric.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
