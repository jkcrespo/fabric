{
  "name": "fabric-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, white-label, agent-ready design system built on MUI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-tokens.mjs",
    "validate:json": "node scripts/validate-tokens.mjs --json",
    "build": "npm run build --workspaces",
    "create-brand": "node scripts/create-brand.mjs",
    "typecheck": "tsc -p tests/tsconfig.json",
    "test": "node --test tests/build.test.mjs tests/ramp.test.mjs",
    "check": "npm run validate && npm run build && npm run typecheck && npm test && npm run test:browser",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jkcrespo/fabric.git"
  },
  "workspaces": [
    "packages/tokens",
    "packages/theme"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
